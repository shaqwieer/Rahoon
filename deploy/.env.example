# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored.
# Use hex values (no ; or quotes): they go into a connection string.  openssl rand -hex 24

POSTGRES_PASSWORD=change-me
# Keys the encrypted personal-data lookups. Never change it after the first start, or seeded data can't be found.
PII_LOOKUP_KEY=change-me

RAHOON_DOMAIN=rahoon.talentfold.net
WEB_PORT=8095

# false (default): no SMS is sent and confirmation codes are confirmed automatically.
SMS_CONFIRMATION=false
