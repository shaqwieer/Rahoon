{
  "$meta": { "name": "rahoon-tokens", "version": "0.1.0", "direction": "rtl", "format": "W3C design-tokens draft" },
  "primitive": {
    "color": {
      "orange": { "500": { "$value": "#F4633A", "$description": "brand.orange — accent only" } },
      "rust": { "50": { "$value": "#FDF0EB" }, "600": { "$value": "#AA4528" }, "700": { "$value": "#8E3920" } },
      "charcoal": { "900": { "$value": "#22262A" } },
      "ink": { "950": { "$value": "#151513" } },
      "neutral": { "0": { "$value": "#FFFFFF" }, "25": { "$value": "#FAF9F6" }, "50": { "$value": "#F2F1ED" }, "200": { "$value": "#CBCAC6" }, "400": { "$value": "#85847F" }, "600": { "$value": "#6B6A65" }, "700": { "$value": "#5E5D58" } },
      "gold": { "300": { "$value": "#D5BD8D" } },
      "green": { "50": { "$value": "#EAF4EE" }, "300": { "$value": "#9CCBB0" }, "700": { "$value": "#1E6A45" } },
      "amber": { "50": { "$value": "#FBF2DE" }, "300": { "$value": "#E2C27A" }, "700": { "$value": "#8A5300" } },
      "red": { "50": { "$value": "#FCECEA" }, "300": { "$value": "#EFA59C" }, "700": { "$value": "#B3261E" } },
      "blue": { "50": { "$value": "#EAF2F9" }, "300": { "$value": "#9DC0DE" }, "700": { "$value": "#1D5A8C" } }
    },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px" },
    "radius": { "xs": "4px", "sm": "6px", "md": "10px", "lg": "14px", "pill": "999px" }
  },
  "semantic": {
    "color": {
      "text": { "primary": "{primitive.color.ink.950}", "strong": "{primitive.color.charcoal.900}", "secondary": "{primitive.color.neutral.600}", "link": "{primitive.color.rust.600}", "inverse": "{primitive.color.neutral.0}" },
      "surface": { "canvas": "{primitive.color.neutral.0}", "warm": "{primitive.color.neutral.25}", "subtle": "{primitive.color.neutral.50}", "inverse": "{primitive.color.ink.950}", "selected": "{primitive.color.rust.50}" },
      "border": { "default": "{primitive.color.neutral.200}", "strong": "{primitive.color.neutral.400}" },
      "action": { "primary": { "bg": "{primitive.color.rust.600}", "bgHover": "{primitive.color.rust.700}", "fg": "#FFFFFF" }, "strong": { "bg": "{primitive.color.ink.950}", "fg": "#FFFFFF" } },
      "accent": "{primitive.color.orange.500}",
      "focus": "{primitive.color.ink.950}",
      "success": { "fg": "{primitive.color.green.700}", "bg": "{primitive.color.green.50}", "border": "{primitive.color.green.300}" },
      "warning": { "fg": "{primitive.color.amber.700}", "bg": "{primitive.color.amber.50}", "border": "{primitive.color.amber.300}" },
      "error": { "fg": "{primitive.color.red.700}", "bg": "{primitive.color.red.50}", "border": "{primitive.color.red.300}" },
      "info": { "fg": "{primitive.color.blue.700}", "bg": "{primitive.color.blue.50}", "border": "{primitive.color.blue.300}" }
    },
    "inverse": { "surface": "#151513", "surfaceRaised": "#22262A", "text": "#FFFFFF", "textSecondary": "#B5B3AD", "border": "#3A3D40", "accent": "#F4633A", "focus": "#FFFFFF" },
    "typography": {
      "family": { "arabic": "IBM Plex Sans Arabic", "latin": "IBM Plex Sans", "mono": "IBM Plex Mono" },
      "scale": {
        "display": { "size": "40px", "lineHeight": "56px", "weight": 700 },
        "h1": { "size": "32px", "lineHeight": "44px", "weight": 700 },
        "h2": { "size": "24px", "lineHeight": "36px", "weight": 600 },
        "h3": { "size": "20px", "lineHeight": "30px", "weight": 600 },
        "bodyLg": { "size": "18px", "lineHeight": "30px", "weight": 400, "use": "debtor journey" },
        "body": { "size": "16px", "lineHeight": "26px", "weight": 400 },
        "bodySm": { "size": "14px", "lineHeight": "22px", "weight": 400, "use": "dense tables" },
        "caption": { "size": "12px", "lineHeight": "18px", "weight": 500, "use": "metadata only" }
      }
    },
    "layout": {
      "breakpoints": { "sm": "390px", "md": "768px", "lg": "1440px" },
      "grid": { "sm": { "cols": 4, "gutter": "16px", "margin": "16px" }, "md": { "cols": 8, "gutter": "24px", "margin": "32px" }, "lg": { "cols": 12, "gutter": "24px", "margin": "40px" } },
      "shell": { "sidenav": "264px", "sidenavCollapsed": "72px", "topbar": "64px" }
    },
    "elevation": { "0": "none", "1": "0 1px 2px rgba(21,21,19,.06), 0 0 0 1px rgba(21,21,19,.04)", "2": "0 4px 12px rgba(21,21,19,.08), 0 0 0 1px rgba(21,21,19,.05)", "3": "0 16px 40px rgba(21,21,19,.14), 0 0 0 1px rgba(21,21,19,.06)" },
    "icon": { "sm": "16px", "md": "20px", "lg": "24px" },
    "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "easeStandard": "cubic-bezier(.2,0,0,1)", "reducedMotion": "0ms" },
    "focus": { "width": "2px", "offset": "2px", "color": "{semantic.color.focus}" },
    "density": {
      "control": { "comfortable": "48px", "default": "40px", "compact": "32px" },
      "row": { "comfortable": "56px", "default": "48px", "compact": "40px" },
      "touchMin": "44px"
    }
  }
}
