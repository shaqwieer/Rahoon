{
  "Web": {
    "AllowedOrigins": [ "https://rahoon.talentfold.net" ]
  },
  "Auth": {
    "SecureCookies": true,
    "ExposeSandboxOtp": false,
    "SmsConfirmation": false,
    "RateLimitPerMinute": 300
  },
  "Storage": {
    "Root": "/data/documents"
  },
  "DataProtection": {
    "KeysPath": "/data/keys"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Alerts": {
    "Enabled": true,
    "IntervalSeconds": 300
  }
}
